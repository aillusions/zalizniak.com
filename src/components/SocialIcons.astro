---
// Override of Starlight's default SocialIcons: identical markup, but each
// header social link opens in a new tab (rel guards against tabnabbing).
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social || [];
---

{
	links.length > 0 && (
		<>
			{/* Brand links with their own favicons, not built-in icons. */}
			<a
				href="https://flowrensic.com/"
				target="_blank"
				rel="me noopener noreferrer"
				class="sl-flex brand-link"
			>
				<span class="sr-only">Flowrensic</span>
				<img src="/flowrensic-icon.svg" alt="" width="16" height="16" decoding="async" />
			</a>
			<a
				href="https://speccraft.io/"
				target="_blank"
				rel="me noopener noreferrer"
				class="sl-flex brand-link"
			>
				<span class="sr-only">SpecCraft</span>
				<img src="/speccraft-icon.png" alt="" width="16" height="16" decoding="async" />
			</a>
			{links.map(({ label, href, icon }) => (
				<a {href} target="_blank" rel="me noopener noreferrer" class="sl-flex">
					<span class="sr-only">{label}</span>
					<Icon name={icon} />
				</a>
			))}
		</>
	)
}

<style>
	@layer starlight.core {
		a {
			color: var(--sl-color-text-accent);
			padding: 0.5em;
			margin: -0.5em;
		}
		a:hover {
			color: var(--sl-color-white);
		}
		/* Match the built-in social SVG icons' rendered size. */
		.brand-link img {
			display: block;
			width: 1em;
			height: 1em;
			border-radius: 3px;
		}
	}
</style>
